{
  "name": "Gokaisho",
  "packageName": "Gokaisho",
  "version": "1.0.0",
  "description": "A minimal Electron application written with Typescript",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "yarn build && electron ./build/main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "Gokaisho",
    "mac": {
      "category": "public.app-category.board-games"
    },
    "extends": null,
    "files": [
      "index.html",
      "build/**/*",
      "package.json",
      "data/**/*",
      "analysis_config.cfg"
    ]
  },
  "repository": "https://github.com/electron/electron-quick-start-typescript",
  "license": "Unlicensed",
  "devDependencies": {
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "electron": "^23.1.0",
    "electron-builder": "^23.3.3",
    "electron-webpack": "^2.8.2",
    "eslint": "^7.32.0",
    "typescript": "^4.7.2",
    "webpack": "^5.74.0"
  },
  "dependencies": {
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stream-splitter": "^0.3.2",
    "ts-sgf-parser": "^0.3.1",
    "uuid": "^8.3.2"
  }
}
